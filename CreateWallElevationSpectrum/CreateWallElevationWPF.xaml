<Window x:Class="CreateWallElevation.CreateWallElevationWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:CreateWallElevation"
        mc:Ignorable="d" Title="Развёртки стен"
        Height="690" Width="660" MinHeight="690" MinWidth="660" MaxHeight="690"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" Icon="Resources/citrus.ico"
        WindowStartupLocation="CenterScreen" KeyDown="CreateWallElevationWPF_KeyDown"
        FontFamily="{DynamicResource BaseFont}" FontSize="{DynamicResource FontSizeBase}"
        Foreground="{DynamicResource TextBrush}" Background="{DynamicResource PageBgBrush}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Fixed" UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyboardNavigation.TabNavigation="Cycle"
        FocusManager.FocusedElement="{Binding ElementName=rbt_ByRoom}" Language="ru-RU">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CitrusTheme/CitrusTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>
            <Style x:Key="FormInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="FormChoice" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <!-- Preserve the GroupBox/Grid contract used by GetCheckedRadioName. -->
            <Style x:Key="ContentGroup" TargetType="GroupBox">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RadioKeyboardFocus" TargetType="Control">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Control">
                            <Rectangle Margin="4" Stroke="{DynamicResource SubtleTextBrush}"
                                       StrokeThickness="1" StrokeDashArray="1,2"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Only the small indicator changes colour; both row halves stay neutral. -->
            <Style x:Key="RowRadio" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                <Setter Property="Height" Value="32"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource RadioKeyboardFocus}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border Background="Transparent" Padding="16,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="16" Height="16" Margin="0,0,12,0">
                                        <Ellipse x:Name="Outer" Fill="White" Stroke="{DynamicResource DividerBrush}" StrokeThickness="1"/>
                                        <Ellipse x:Name="Inner" Width="10" Height="10" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                                    </Grid>
                                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource AccentBorderBrush}"/>
                                    <Setter TargetName="Inner" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                                    <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource Neutral300Brush}"/>
                                    <Setter TargetName="Inner" Property="Fill" Value="{DynamicResource Neutral300Brush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
        <StackPanel Margin="20,18,20,16">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Построение" Style="{StaticResource SectionHeading}" Margin="0"/>
                <Border Grid.Column="1" Height="1" Background="{DynamicResource DividerBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/><RowDefinition Height="10"/><RowDefinition Height="32"/>
                    <RowDefinition Height="10"/><RowDefinition Height="32"/><RowDefinition Height="10"/><RowDefinition Height="32"/>
                </Grid.RowDefinitions>
                <Label Content="Основа:" Target="{Binding ElementName=rbt_ByRoom}"/>
                <GroupBox x:Name="groupBox_BuildBy" Grid.Column="1" Style="{StaticResource ContentGroup}"
                          TabIndex="0" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" IsHitTestVisible="False"/>
                        <Border Grid.Column="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0" IsHitTestVisible="False"/>
                        <RadioButton x:Name="rbt_ByRoom" Content="Помещение" IsChecked="True" Style="{StaticResource RowRadio}"
                                     GroupName="BuildBy" TabIndex="0" Checked="BuildByCheckedChanged"/>
                        <RadioButton x:Name="rbt_ByWall" Grid.Column="1" Content="Стена" Style="{StaticResource RowRadio}"
                                     GroupName="BuildBy" TabIndex="1" Checked="BuildByCheckedChanged"/>
                    </Grid>
                </GroupBox>
                <Label Grid.Row="2" Content="Вид:" Target="{Binding ElementName=rbt_Section}"/>
                <GroupBox x:Name="groupBox_UseToBuild" Grid.Row="2" Grid.Column="1" Style="{StaticResource ContentGroup}"
                          TabIndex="2" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" IsHitTestVisible="False"/>
                        <Border Grid.Column="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0" IsHitTestVisible="False"/>
                        <RadioButton x:Name="rbt_Section" Content="Разрез" IsChecked="True" Style="{StaticResource RowRadio}"
                                     GroupName="UseToBuild" TabIndex="2" Checked="UseToBuildCheckedChanged"/>
                        <RadioButton x:Name="rbt_Facade" Grid.Column="1" Content="Фасад" Style="{StaticResource RowRadio}"
                                     GroupName="UseToBuild" TabIndex="3" Checked="UseToBuildCheckedChanged"/>
                    </Grid>
                </GroupBox>
                <Label x:Name="label_SelectTypeSectionFacade" Grid.Row="4" Content="Тип вида:" Target="{Binding ElementName=comboBox_SelectTypeSectionFacade}"/>
                <ComboBox x:Name="comboBox_SelectTypeSectionFacade" Grid.Row="4" Grid.Column="1" Style="{StaticResource FormChoice}"
                          TabIndex="4" AutomationProperties.Name="Тип вида"/>
                <CheckBox x:Name="checkBox_UseTemplate" Grid.Row="6" Content="Шаблон:" VerticalAlignment="Center" TabIndex="5"
                          Checked="checkBox_UseTemplate_Checked" Unchecked="checkBox_UseTemplate_Checked"/>
                <ComboBox x:Name="comboBox_UseTemplate" Grid.Row="6" Grid.Column="1" Style="{StaticResource FormChoice}"
                          IsEnabled="False" TabIndex="6" AutomationProperties.Name="Шаблон вида"/>
            </Grid>

            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Геометрия" Style="{StaticResource SectionHeading}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/><ColumnDefinition Width="82"/><ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/><ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/><RowDefinition Height="10"/><RowDefinition Height="32"/>
                            <RowDefinition Height="10"/><RowDefinition Height="32"/>
                        </Grid.RowDefinitions>
                        <Label x:Name="label_Indent" Content="Отступ от стены:" Target="{Binding ElementName=textBox_Indent}"/>
                        <TextBox x:Name="textBox_Indent" Grid.Column="1" Text="300" TabIndex="7" Style="{StaticResource FormInput}" AutomationProperties.Name="Отступ от стены, мм"/>
                        <Label x:Name="label_IndentMM" Grid.Column="2" Content="мм" Margin="10,0,0,0"/>
                        <Label x:Name="label_ProjectionDepth" Grid.Column="4" Content="Глубина:" Target="{Binding ElementName=textBox_ProjectionDepth}"/>
                        <TextBox x:Name="textBox_ProjectionDepth" Grid.Column="5" Text="500" TabIndex="8" Style="{StaticResource FormInput}" AutomationProperties.Name="Глубина проекции, мм"/>
                        <Label x:Name="label_ProjectionDepthMM" Grid.Column="6" Content="мм" Margin="10,0,0,0"/>

                        <Label x:Name="label_IndentUp" Grid.Row="2" Content="Сверху:" Target="{Binding ElementName=textBox_IndentUp}"/>
                        <TextBox x:Name="textBox_IndentUp" Grid.Row="2" Grid.Column="1" Text="0" TabIndex="9" Style="{StaticResource FormInput}" AutomationProperties.Name="Отступ сверху, мм"/>
                        <Label x:Name="label_IndentUpMM" Grid.Row="2" Grid.Column="2" Content="мм" Margin="10,0,0,0"/>
                        <Label x:Name="label_IndentDown" Grid.Row="2" Grid.Column="4" Content="Снизу:" Target="{Binding ElementName=textBox_IndentDown}"/>
                        <TextBox x:Name="textBox_IndentDown" Grid.Row="2" Grid.Column="5" Text="0" TabIndex="10"
                                 Style="{StaticResource FormInput}" AutomationProperties.Name="Смещение снизу, мм"
                                 ToolTip="−100 мм опускает нижнюю границу вида на 100 мм, чтобы показать пол. +100 мм поднимает её на 100 мм."/>
                        <Label x:Name="label_IndentDownMM" Grid.Row="2" Grid.Column="6" Content="мм" Margin="10,0,0,0"/>

                        <Label x:Name="label_CurveNumberOfSegments" Grid.Row="4" Content="Сегментов кривой:" Target="{Binding ElementName=textBox_CurveNumberOfSegments}"/>
                        <TextBox x:Name="textBox_CurveNumberOfSegments" Grid.Row="4" Grid.Column="1" Text="10" TabIndex="11"
                                 Style="{StaticResource FormInput}" AutomationProperties.Name="Количество сегментов кривой"/>
                        <Label x:Name="label_CurveNumberOfSegmentsCNT" Grid.Row="4" Grid.Column="2" Content="шт" Visibility="Collapsed"/>
                        <!-- Wall mode disables only the minimum-length setting. -->
                        <GroupBox x:Name="groupBox_Simplify" Grid.Row="4" Grid.Column="4" Grid.ColumnSpan="3" Style="{StaticResource ContentGroup}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                <Label Content="Мин. длина:" Target="{Binding ElementName=textBox_MinSegmentLength}"/>
                                <TextBox x:Name="textBox_MinSegmentLength" Grid.Column="1" Text="1000" TabIndex="12"
                                         Style="{StaticResource FormInput}" AutomationProperties.Name="Минимальная длина сегмента, мм"/>
                                <Label Grid.Column="2" Content="мм" Margin="10,0,0,0"/>
                            </Grid>
                        </GroupBox>
                    </Grid>
                    <TextBlock Text="Отрицательное смещение снизу позволяет показать пол." Foreground="{DynamicResource SubtleTextBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Именование и размещение" Style="{StaticResource SectionHeading}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="10"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                        <Label Content="Префикс:" Target="{Binding ElementName=textBox_ViewNamePrefix}"/>
                        <TextBox x:Name="textBox_ViewNamePrefix" Grid.Column="1" Style="{StaticResource FormInput}" TabIndex="13"
                                 AutomationProperties.Name="Префикс имени вида" ToolTip="АР → АР_101_1_12345; пустое поле — автоматический префикс"/>
                        <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Text" Value="{Binding Text, ElementName=textBox_ViewNamePrefix, StringFormat='{}{0}_101_1_…'}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=rbt_ByWall}" Value="True">
                                            <Setter Property="Text" Value="{Binding Text, ElementName=textBox_ViewNamePrefix, StringFormat='{}{0}_1_…'}"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Text, ElementName=textBox_ViewNamePrefix}" Value=""/>
                                                <Condition Binding="{Binding IsChecked, ElementName=rbt_ByRoom}" Value="True"/>
                                                <Condition Binding="{Binding IsChecked, ElementName=rbt_Section}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="Р_П101_1_…"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Text, ElementName=textBox_ViewNamePrefix}" Value=""/>
                                                <Condition Binding="{Binding IsChecked, ElementName=rbt_ByRoom}" Value="True"/>
                                                <Condition Binding="{Binding IsChecked, ElementName=rbt_Facade}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="Ф_П101_1_…"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Text, ElementName=textBox_ViewNamePrefix}" Value=""/>
                                                <Condition Binding="{Binding IsChecked, ElementName=rbt_ByWall}" Value="True"/>
                                                <Condition Binding="{Binding IsChecked, ElementName=rbt_Section}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="Р_Ст_1_…"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Text, ElementName=textBox_ViewNamePrefix}" Value=""/>
                                                <Condition Binding="{Binding IsChecked, ElementName=rbt_ByWall}" Value="True"/>
                                                <Condition Binding="{Binding IsChecked, ElementName=rbt_Facade}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="Ф_Ст_1_…"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Label x:Name="label_PlaceOnSheet" Grid.Row="2" Content="Лист:" Target="{Binding ElementName=comboBox_PlaceOnSheet}"/>
                        <ComboBox x:Name="comboBox_PlaceOnSheet" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                  Style="{StaticResource FormChoice}" DisplayMemberPath="DisplayName" TabIndex="14" AutomationProperties.Name="Лист для размещения"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Параметры запоминаются" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"/>
                <Button x:Name="btn_Cancel" Grid.Column="1" Content="Отмена" Width="100" Height="34" Margin="12,0,8,0" Padding="10,0"
                        IsCancel="True" TabIndex="15" Style="{StaticResource ButtonOutline}" Click="btn_Cancel_Click"/>
                <Button x:Name="btn_Ok" Grid.Column="2" Content="Создать развёртки" Width="168" Height="34" Padding="12,0"
                        IsDefault="True" TabIndex="16" Click="btn_Ok_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
